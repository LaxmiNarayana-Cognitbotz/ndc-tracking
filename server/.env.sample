# Database Credentials
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
SSL_MODE=require

# Use SQLite for local development (to bypass corporate network firewall issues)
USE_SQLITE=false

# JWT Credentials
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200
RESET_PASSWORD_EXPIRE_MINUTES=15

# Excel upload directory
UPLOAD_DIR=uploads

# Email Notification Toggle (on/off) — controls all email sending across the application
EMAIL_NOTIFICATION=on

# SMTP Config (Development / Gmail or Corporate SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@example.com
EMAIL_RECIPIENT=recipient@example.com
FNF_EMAIL_CC=cc1@example.com,cc2@example.com

# Production (Adani) Config Example (Uncomment for production deployment)
# SMTP_HOST=smtp.adani.com
# SMTP_PORT=25
# SMTP_USER=user@adani.com
# SMTP_PASSWORD=
# SMTP_FROM=user@adani.com
# ADMIN_EMAILS=admin@adani.com
# EMAIL_RECIPIENT=recipient@adani.com
# FNF_EMAIL_CC=cc1@adani.com,cc2@adani.com

# SharePoint credentials (NDC-Automation)
SHAREPOINT_TENANT_ID=your_sharepoint_tenant_id
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/YourSite
SHAREPOINT_CLIENT_ID=your_sharepoint_client_id
SHAREPOINT_CLIENT_SECRET=your_sharepoint_client_secret
SHAREPOINT_TARGET_FOLDER=/sites/YourSite/Shared Documents/Folder

# SharePoint Reports Sync Config
SHAREPOINT_REPORTS_SUBFOLDER=NDC_Reports
SHAREPOINT_SYNC_BACKGROUND_POLL=true
SHAREPOINT_SYNC_SCHEDULED_TIMES=10:10,13:10,16:10,19:10

# SharePoint SSL Verification config (set to 'false' or path to corporate CA bundle if running on a corporate network/VM behind SSL-decrypting proxies)
SHAREPOINT_SSL_VERIFY=true

# Proxy Settings (used in corporate networks / VMs if proxy/SSL-decryption is enabled)
PROXY_ENABLED=false
PROXY_URL=
PROXY_INSECURE_SSL=false

# SSO Configuration
# SSO_ENABLED — when True: Azure AD login enforced; when False: direct site access (no auth, no login UI)
SSO_ENABLED=False
AZURE_AD_CLIENT_ID=your_azure_ad_client_id
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
AZURE_AD_TENANT_ID=your_azure_ad_tenant_id
AZURE_AD_REDIRECT_URI=http://localhost:8010/api/auth/callback
SUPER_ADMIN_EMAIL=superadmin@example.com